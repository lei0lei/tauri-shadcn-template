{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "exec-sh",
          "cmd": "powershell.exe",
          "args": [
            "-Command",
            {
              "validator": ".*"
            }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "exec-sh",
          "cmd": "powershell.exe",
          "args": [
            "-Command",
            {
              "validator": ".*"
            }
          ]
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    "fs:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": ".*\\.pdf$",
          "recursive": true
        }
      ]
    },
    {
    "identifier": "fs:default",
    "allow": [{ "path": "D:/pdfresult/**", "recursive": true }]
  },
    "dialog:default",
    "fs:default",
    "dialog:default"
  ]
}